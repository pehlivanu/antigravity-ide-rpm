[Unit]
Description=Daily check for Antigravity IDE updates

[Timer]
# The upstream check-update.yml workflow runs at 06:00 UTC and the COPR
# rebuild typically finishes within a few minutes; 10:00 local time leaves a
# comfortable buffer.
OnCalendar=*-*-* 10:00:00
RandomizedDelaySec=30min
Persistent=true

[Install]
WantedBy=timers.target
